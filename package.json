{
  "name": "alia-harness",
  "version": "1.0.0",
  "description": "CLI agent harness for Alia LLMs with custom endpoints and tool calling",
  "type": "module",
  "main": "dist/core/index.js",
  "exports": {
    ".": "./dist/core/index.js",
    "./core": "./dist/core/index.js"
  },
  "bin": {
    "alia-agent": "dist/cli/index.js"
  },
  "scripts": {
    "start": "tsx src/cli/index.ts",
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:mentions": "tsx scripts/smoke-mentions.ts && tsx scripts/tty-mentions.ts",
    "test:skills": "tsx scripts/smoke-skills.ts",
    "test:agent": "tsx scripts/smoke-agent.ts",
    "test:subagents": "tsx scripts/smoke-subagents.ts",
    "test:session": "tsx scripts/smoke-session.ts",
    "test:events": "tsx scripts/smoke-events.ts",
    "test:cancel": "tsx scripts/smoke-cancel.ts",
    "test:permissions": "tsx scripts/smoke-permissions.ts",
    "test:store": "tsx scripts/smoke-store.ts",
    "test:commands": "tsx scripts/smoke-commands.ts",
    "test:changes": "tsx scripts/smoke-changes.ts",
    "test:documents": "tsx scripts/smoke-documents.ts",
    "test:office": "tsx scripts/smoke-office.ts",
    "test:askuser": "tsx scripts/smoke-askuser.ts",
    "test:pipeline": "tsx scripts/smoke-pipeline.ts",
    "test:resume": "tsx scripts/smoke-resume.ts",
    "test:intake": "tsx scripts/smoke-intake.ts",
    "test:report": "tsx scripts/smoke-report.ts",
    "test:streaming": "tsx scripts/smoke-streaming.ts",
    "test:issues": "tsx scripts/smoke-issues.ts",
    "test:e2e": "tsx scripts/smoke-e2e.ts",
    "desktop:install": "npm --prefix desktop install",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:typecheck": "npm --prefix desktop run typecheck",
    "desktop:smoke": "npm --prefix desktop run smoke",
    "desktop:test:engine": "npm --prefix desktop run test:engine",
    "desktop:test:app": "npm --prefix desktop run test:app",
    "desktop:test:security": "npm --prefix desktop run test:security",
    "desktop:test:hardening": "npm --prefix desktop run test:hardening",
    "desktop:test:package": "npm --prefix desktop run test:package",
    "desktop:test:settings": "npm --prefix desktop run test:settings",
    "desktop:test:settings-app": "npm --prefix desktop run test:settings-app",
    "desktop:test:projects": "npm --prefix desktop run test:projects",
    "desktop:test:ui-logic": "npm --prefix desktop run test:ui-logic",
    "desktop:test:sidebar-app": "npm --prefix desktop run test:sidebar-app",
    "desktop:test:timeline": "npm --prefix desktop run test:timeline",
    "desktop:test:timeline-app": "npm --prefix desktop run test:timeline-app",
    "desktop:test:composer-logic": "npm --prefix desktop run test:composer-logic",
    "desktop:test:composer-app": "npm --prefix desktop run test:composer-app",
    "desktop:test:interactions-logic": "npm --prefix desktop run test:interactions-logic",
    "desktop:test:interactions-app": "npm --prefix desktop run test:interactions-app",
    "desktop:test:panel-logic": "npm --prefix desktop run test:panel-logic",
    "desktop:test:panel-app": "npm --prefix desktop run test:panel-app",
    "desktop:test:intake-logic": "npm --prefix desktop run test:intake-logic",
    "desktop:test:intake-app": "npm --prefix desktop run test:intake-app",
    "desktop:test:run-logic": "npm --prefix desktop run test:run-logic",
    "desktop:test:run-app": "npm --prefix desktop run test:run-app",
    "desktop:test:gates-app": "npm --prefix desktop run test:gates-app",
    "desktop:test:report-app": "npm --prefix desktop run test:report-app",
    "desktop:test:journey-app": "npm --prefix desktop run test:journey-app",
    "desktop:test:diagnostics": "npm --prefix desktop run test:diagnostics",
    "desktop:test:diagnostics-app": "npm --prefix desktop run test:diagnostics-app",
    "desktop:test:installer": "npm --prefix desktop run test:installer",
    "desktop:test:contrast": "npm --prefix desktop run test:contrast",
    "desktop:test:strings": "npm --prefix desktop run test:strings",
    "desktop:test:keyboard-app": "npm --prefix desktop run test:keyboard-app",
    "desktop:test:performance-app": "npm --prefix desktop run test:performance-app",
    "desktop:test:streaming-app": "npm --prefix desktop run test:streaming-app",
    "desktop:pack": "npm --prefix desktop run pack",
    "desktop:dist": "npm --prefix desktop run dist",
    "desktop:test:all": "npm --prefix desktop run test:all",
    "desktop:screenshots": "npm --prefix desktop run screenshots"
  },
  "keywords": [
    "ai",
    "agent",
    "alia",
    "llm",
    "cli",
    "harness"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "openai": "^7.54.0",
    "picocolors": "^1.1.1",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
