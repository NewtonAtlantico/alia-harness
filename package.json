{
  "name": "alia-harness",
  "version": "1.0.0",
  "description": "CLI agent harness for Alia LLMs with custom endpoints and tool calling",
  "type": "module",
  "main": "dist/core/index.js",
  "exports": {
    ".": "./dist/core/index.js",
    "./core": "./dist/core/index.js"
  },
  "bin": {
    "alia-agent": "dist/cli/index.js"
  },
  "scripts": {
    "start": "tsx src/cli/index.ts",
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:mentions": "tsx scripts/smoke-mentions.ts && tsx scripts/tty-mentions.ts",
    "test:skills": "tsx scripts/smoke-skills.ts",
    "test:agent": "tsx scripts/smoke-agent.ts",
    "test:subagents": "tsx scripts/smoke-subagents.ts",
    "test:session": "tsx scripts/smoke-session.ts",
    "test:events": "tsx scripts/smoke-events.ts",
    "test:cancel": "tsx scripts/smoke-cancel.ts",
    "test:permissions": "tsx scripts/smoke-permissions.ts",
    "test:store": "tsx scripts/smoke-store.ts",
    "test:commands": "tsx scripts/smoke-commands.ts"
  },
  "keywords": ["ai", "agent", "alia", "llm", "cli", "harness"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "openai": "^7.54.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
