{
  "name": "alia-harness-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Desktop app for the alia harness (Electron shell over src/core)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "npm run build && tsx scripts/smoke-app.ts",
    "test:engine": "tsx --tsconfig tsconfig.node.json scripts/test-engine.ts",
    "test:app": "npm run build && tsx --tsconfig tsconfig.node.json scripts/test-app.ts",
    "test:security": "tsx --tsconfig tsconfig.node.json scripts/test-security.ts",
    "test:hardening": "npm run build && tsx --tsconfig tsconfig.node.json scripts/test-hardening.ts",
    "test:package": "tsx --tsconfig tsconfig.node.json scripts/test-package.ts"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  }
}
